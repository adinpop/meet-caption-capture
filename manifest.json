{
  "manifest_version": 3,
  "name": "RUBICON Meet Caption Capture",
  "version": "0.8.2",
  "description": "Captures Google Meet and Microsoft Teams live captions to a Markdown (.md) file per meeting. Optional audio recording transcribed via OpenAI Whisper. Auto-save the resulting transcripts to a Google Drive folder you choose.",
  "key": "",
  "oauth2": {
    "client_id": "564751840053-svqop3hten0s5e4v3kunpirpd475sjno.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file",
      "https://www.googleapis.com/auth/drive.metadata.readonly"
    ]
  },
  "permissions": ["storage", "downloads", "offscreen", "tabCapture", "activeTab", "identity"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.cloud.microsoft/*",
    "https://teams.live.com/*",
    "https://api.openai.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "RUBICON Meet Caption Capture",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*",
        "https://teams.live.com/*"
      ],
      "js": ["src/content/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
